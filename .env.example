# NutriAI Environment Configuration Example
PROJECT_NAME="NutriAI - Personal Food, Health & Fitness Intelligence"
API_V1_STR="/api/v1"
SECRET_KEY="generate-a-secure-random-secret-key-using-openssl-rand-hex-32"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database URL
# Default local SQLite:
DATABASE_URL="sqlite+aiosqlite:///./nutriai.db"
# PostgreSQL production:
# DATABASE_URL="postgresql+asyncpg://user:password@localhost:5432/nutriai"

# Google Gemini API Settings (Get your key from https://aistudio.google.com/)
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-flash-latest"

# CORS Origins (JSON list or comma-separated)
BACKEND_CORS_ORIGINS=["http://localhost:5173","http://localhost:3000","http://127.0.0.1:5173"]
